#!/usr/bin/env bash
#
set -e # exit immediately if a simple command exits with a non-zero status
set -u # report the usage of uninitialized variables

# Load job properties
source /var/vcap/jobs/mimir-rules/data/properties.sh

# Setup env vars and folders
source /var/vcap/jobs/mimir-rules/packages/bosh-helpers/setup.sh "mimir-rules"

# Load function lib
source /var/vcap/jobs/mimir-rules/packages/bosh-helpers/lib.sh

MIMIRTOOL=/var/vcap/jobs/mimir-rules/packages/mimirtool-linux-amd64/bin/mimirtool
RULES_FILE=/var/vcap/jobs/mimir-rules/config/rules.yaml

# All output appended to the log file and echoed to stdout
exec > >(tee -a "${LOG_DIR}/mimir-rules.log") 2>&1

fail() {
  local msg="${1}"
  if [ "${FAIL_ON_ERROR}" == "true" ]; then
    echo_log "ERROR: ${msg}"
    exit 1
  fi
  echo_log "WARNING: ${msg} (fail_on_error=false, ignoring)"
  exit 0
}

if [ "${ENABLED}" != "true" ]; then
  echo_log "mimir-rules disabled, nothing to do"
  exit 0
fi

if [ "${BOOTSTRAP_ONLY}" == "true" ] && [ "${INSTANCE_BOOTSTRAP}" != "1" ]; then
  echo_log "Not bootstrap instance (${JOB_FULL}) and bootstrap_only=true, skipping"
  exit 0
fi

<%
  require 'yaml'
  require 'shellwords'
  raw = p('mimir-rules.enabled') ? p('mimir-rules.rules') : p('mimir-rules.rules', { 'groups' => [] })
  rules = raw.is_a?(String) ? YAML.safe_load(raw) : raw
  rules = {} unless rules.is_a?(Hash)
  rule_groups = (rules['groups'] || []).map { |g| g.is_a?(Hash) ? g['name'].to_s : '' }.reject(&:empty?)
-%>
NAMESPACE=<%= Shellwords.escape(rules['namespace'].to_s) %>
RULE_GROUPS=(<%= rule_groups.map { |g| Shellwords.escape(g) }.join(' ') %>)

if [ -z "${NAMESPACE}" ]; then
  fail "No namespace defined in ${RULES_FILE}, it is mandatory"
fi

if [ -z "${MIMIR_ADDRESS}" ] || [ -z "${MIMIR_TENANT_ID}" ]; then
  fail "mimir-rules.address and mimir-rules.tenant_id are mandatory"
fi

echo_log "Checking rules file ${RULES_FILE} (namespace=${NAMESPACE}) ..."
if ! "${MIMIRTOOL}" rules check "${RULES_FILE}"; then
  fail "mimirtool rules check failed for ${RULES_FILE}"
fi

COMMON_ARGS=(--address="${MIMIR_ADDRESS}" --id="${MIMIR_TENANT_ID}")

run_mimirtool() {
  case "${SYNC_MODE}" in
    load)
      "${MIMIRTOOL}" rules load "${COMMON_ARGS[@]}" "${RULES_FILE}"
      ;;
    sync)
      # Limit sync to our namespace, otherwise mimirtool deletes every other
      # namespace of the tenant that is not present in the rules file
      "${MIMIRTOOL}" rules sync "${COMMON_ARGS[@]}" --namespaces="${NAMESPACE}" "${RULES_FILE}"
      ;;
    delete-namespace)
      "${MIMIRTOOL}" rules delete-namespace "${COMMON_ARGS[@]}" "${NAMESPACE}"
      ;;
    delete-groups)
      local group
      for group in ${RULE_GROUPS[@]+"${RULE_GROUPS[@]}"}; do
        echo_log "Deleting group '${group}' in namespace '${NAMESPACE}' ..."
        "${MIMIRTOOL}" rules delete "${COMMON_ARGS[@]}" "${NAMESPACE}" "${group}" || return 1
      done
      ;;
    *)
      echo_log "Unknown sync_mode '${SYNC_MODE}'"
      return 1
      ;;
  esac
}

# MIMIR_API_USER / MIMIR_API_KEY are read by mimirtool from the environment.
# Never print MIMIR_API_KEY.
attempt=1
delay=5
while true; do
  echo_log "Running mimirtool rules ${SYNC_MODE} (address=${MIMIR_ADDRESS}, tenant=${MIMIR_TENANT_ID}, namespace=${NAMESPACE}, attempt ${attempt}/${RETRIES}) ..."
  if run_mimirtool; then
    echo_log "Rules ${SYNC_MODE} done"
    exit 0
  fi
  if [ "${attempt}" -ge "${RETRIES}" ]; then
    break
  fi
  echo_log "mimirtool rules ${SYNC_MODE} failed, retrying in ${delay}s ..."
  sleep "${delay}"
  attempt=$((attempt + 1))
  delay=$((delay * 2))
done

fail "mimirtool rules ${SYNC_MODE} failed after ${RETRIES} attempts"
