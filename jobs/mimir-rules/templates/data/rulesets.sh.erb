<%
  # Renders all the rule sets as bash arrays (sourced by bin/sync.sh).
  # Every rule set is validated here, so a bad manifest fails the deploy at
  # render time. Rules content is rendered with YAML.dump from the parsed data
  # and base64 encoded, so Go templates ({{ $labels.x }}), '%', '$' and YAML
  # special characters reach Mimir unchanged.
  require 'yaml'
  require 'base64'
  require 'shellwords'

  sync_modes = %w(load sync delete-namespace delete-groups)
  id_regex = /\A[A-Za-z0-9][A-Za-z0-9_.-]*\z/

  parse = lambda do |what, value|
    data = value.is_a?(String) ? YAML.safe_load(value) : value
    raise "mimir-rules: #{what} must be a YAML mapping" unless data.is_a?(Hash)
    data
  end

  enabled = p('mimir-rules.enabled')
  defaults = {
    'address'   => p('mimir-rules.address', '').to_s,
    'tenant_id' => p('mimir-rules.tenant_id', '').to_s,
    'sync_mode' => p('mimir-rules.sync_mode').to_s,
    'user'      => p('mimir-rules.auth.user', '').to_s,
    'key'       => p('mimir-rules.auth.key', '').to_s,
  }

  rulesets = {}
  if enabled
    p('mimir-rules.rulesets', {}).each do |id, value|
      rulesets[id.to_s] = parse.call("rulesets.#{id}", value)
    end
    if_p('mimir-rules.rules') do |legacy|
      if rulesets.key?('default')
        raise "mimir-rules: 'rules' (legacy, rule set 'default') and 'rulesets.default' are both set; use only one"
      end
      # v4.2.0 format: {namespace, groups}, inherits all top-level settings
      rulesets['default'] = parse.call('rules', legacy)
    end
    if rulesets.empty?
      raise "mimir-rules: enabled but neither 'rules' nor 'rulesets' are defined"
    end
  end

  active = []
  disabled = []
  seen = {}
  rulesets.keys.sort.each do |id|
    rs = rulesets[id]
    raise "mimir-rules: invalid rule set id '#{id}' (allowed: #{id_regex.source})" unless id =~ id_regex
    if rs.key?('enabled') && rs['enabled'] != true && rs['enabled'] != false
      raise "mimir-rules: rulesets.#{id}.enabled must be true or false"
    end
    if rs['enabled'] == false
      disabled << id
      next
    end
    namespace = rs['namespace']
    if !namespace.is_a?(String) || namespace.strip.empty?
      raise "mimir-rules: rule set '#{id}' must define a non-empty 'namespace'"
    end
    groups = rs['groups']
    raise "mimir-rules: rule set '#{id}' must contain a 'groups' array" unless groups.is_a?(Array)
    group_names = groups.each_with_index.map do |g, i|
      unless g.is_a?(Hash) && g['name'].is_a?(String) && !g['name'].strip.empty?
        raise "mimir-rules: rule set '#{id}' group ##{i} must be a mapping with a non-empty 'name'"
      end
      if g['name'].include?("\n")
        raise "mimir-rules: rule set '#{id}' group names cannot contain new lines"
      end
      g['name']
    end
    auth = rs['auth'].is_a?(Hash) ? rs['auth'] : {}
    cfg = {
      'id'        => id,
      'namespace' => namespace,
      'address'   => (rs['address'] || defaults['address']).to_s,
      'tenant_id' => (rs['tenant_id'] || defaults['tenant_id']).to_s,
      'sync_mode' => (rs['sync_mode'] || defaults['sync_mode']).to_s,
      'user'      => (auth['user'] || defaults['user']).to_s,
      'key'       => (auth['key'] || defaults['key']).to_s,
      'groups'    => group_names,
    }
    raise "mimir-rules: rule set '#{id}' has no 'address' (set it or mimir-rules.address)" if cfg['address'].empty?
    raise "mimir-rules: rule set '#{id}' has no 'tenant_id' (set it or mimir-rules.tenant_id)" if cfg['tenant_id'].empty?
    unless sync_modes.include?(cfg['sync_mode'])
      raise "mimir-rules: rule set '#{id}' sync_mode '#{cfg['sync_mode']}' must be one of: #{sync_modes.join(', ')}"
    end
    owner = [cfg['address'], cfg['tenant_id'], namespace]
    if seen.key?(owner)
      raise "mimir-rules: rule sets '#{seen[owner]}' and '#{id}' use the same namespace '#{namespace}' in tenant '#{cfg['tenant_id']}' (#{cfg['address']})"
    end
    seen[owner] = id
    # mimirtool rule file format: {namespace, groups}. Groups pass through as-is.
    cfg['content'] = YAML.dump({ 'namespace' => namespace, 'groups' => groups })
    active << cfg
  end

  q = lambda { |s| Shellwords.escape(s.to_s) }
  arr = lambda { |field| active.map { |c| q.call(c[field]) }.join(' ') }
-%>
#!/usr/bin/env bash
# Generated by BOSH. Contains credentials: do not print.
RS_DISABLED=(<%= disabled.map { |id| q.call(id) }.join(' ') %>)
RS_ID=(<%= arr.call('id') %>)
RS_NAMESPACE=(<%= arr.call('namespace') %>)
RS_ADDRESS=(<%= arr.call('address') %>)
RS_TENANT_ID=(<%= arr.call('tenant_id') %>)
RS_SYNC_MODE=(<%= arr.call('sync_mode') %>)
RS_USER=(<%= arr.call('user') %>)
RS_KEY=(<%= arr.call('key') %>)
# base64: list of group names (one per line)
RS_GROUPS=(<%= active.map { |c| q.call(Base64.strict_encode64(c['groups'].join("\n"))) }.join(' ') %>)
# base64: rules file content ({namespace, groups})
RS_CONTENT=(<%= active.map { |c| q.call(Base64.strict_encode64(c['content'])) }.join(' ') %>)
