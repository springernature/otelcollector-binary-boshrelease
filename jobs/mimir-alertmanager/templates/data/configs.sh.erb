<%
  # Renders all the Alertmanager configs as bash arrays (sourced by bin/sync.sh).
  # Validated here, so a bad manifest fails the deploy at render time.
  # Content is base64 encoded, so Go templates ({{ ... }}), '$', '%' and YAML
  # special characters reach Mimir unchanged.
  require 'yaml'
  require 'base64'
  require 'shellwords'

  modes = %w(load delete)
  id_regex = /\A[A-Za-z0-9][A-Za-z0-9_.-]*\z/
  tmpl_regex = /\A[A-Za-z0-9][A-Za-z0-9_.-]*\z/

  defaults = {
    'address' => p('mimir-alertmanager.address', '').to_s,
    'user'    => p('mimir-alertmanager.auth.user', '').to_s,
    'key'     => p('mimir-alertmanager.auth.key', '').to_s,
  }

  configs = {}
  if p('mimir-alertmanager.enabled')
    p('mimir-alertmanager.configs', {}).each do |id, value|
      raise "mimir-alertmanager: configs.#{id} must be a mapping" unless value.is_a?(Hash)
      configs[id.to_s] = value
    end
    raise "mimir-alertmanager: enabled but no 'configs' defined" if configs.empty?
  end

  active = []
  disabled = []
  seen = {}
  configs.keys.sort.each do |id|
    c = configs[id]
    raise "mimir-alertmanager: invalid config id '#{id}' (allowed: #{id_regex.source})" unless id =~ id_regex
    if c.key?('enabled') && c['enabled'] != true && c['enabled'] != false
      raise "mimir-alertmanager: configs.#{id}.enabled must be true or false"
    end
    if c['enabled'] == false
      disabled << id
      next
    end
    auth = c['auth'].is_a?(Hash) ? c['auth'] : {}
    cfg = {
      'id'        => id,
      'tenant_id' => c['tenant_id'].to_s,
      'address'   => (c['address'] || defaults['address']).to_s,
      'mode'      => (c['mode'] || 'load').to_s,
      'user'      => (auth['user'] || defaults['user']).to_s,
      'key'       => (auth['key'] || defaults['key']).to_s,
      'config'    => '',
      'templates' => [],
    }
    raise "mimir-alertmanager: config '#{id}' must define a non-empty 'tenant_id'" if cfg['tenant_id'].strip.empty?
    raise "mimir-alertmanager: config '#{id}' has no 'address' (set it or mimir-alertmanager.address)" if cfg['address'].empty?
    unless modes.include?(cfg['mode'])
      raise "mimir-alertmanager: config '#{id}' mode '#{cfg['mode']}' must be one of: #{modes.join(', ')}"
    end
    owner = [cfg['address'], cfg['tenant_id']]
    if seen.key?(owner)
      raise "mimir-alertmanager: configs '#{seen[owner]}' and '#{id}' use the same tenant '#{cfg['tenant_id']}' (#{cfg['address']}); Mimir holds one Alertmanager config per tenant"
    end
    seen[owner] = id

    if cfg['mode'] == 'load'
      am = c['config'].is_a?(String) ? YAML.safe_load(c['config']) : c['config']
      unless am.is_a?(Hash) && !am.empty?
        raise "mimir-alertmanager: config '#{id}' must define 'config' (alertmanager.yml) as a non-empty mapping or YAML string"
      end
      cfg['config'] = YAML.dump(am)
      templates = c['templates'] || {}
      raise "mimir-alertmanager: config '#{id}' 'templates' must be a mapping of name => content" unless templates.is_a?(Hash)
      templates.keys.map(&:to_s).sort.each do |name|
        raise "mimir-alertmanager: config '#{id}' invalid template name '#{name}' (allowed: #{tmpl_regex.source})" unless name =~ tmpl_regex
        content = templates[name]
        raise "mimir-alertmanager: config '#{id}' template '#{name}' must be a string" unless content.is_a?(String)
        # template content is passed byte-for-byte (not YAML)
        cfg['templates'] << [name, content]
      end
    end
    active << cfg
  end

  q = lambda { |s| Shellwords.escape(s.to_s) }
  b64 = lambda { |s| q.call(Base64.strict_encode64(s.to_s)) }
  arr = lambda { |field| active.map { |c| q.call(c[field]) }.join(' ') }
-%>
#!/usr/bin/env bash
# Generated by BOSH. Contains credentials (API keys, receiver secrets): do not print.
AM_DISABLED=(<%= disabled.map { |id| q.call(id) }.join(' ') %>)
AM_ID=(<%= arr.call('id') %>)
AM_TENANT_ID=(<%= arr.call('tenant_id') %>)
AM_ADDRESS=(<%= arr.call('address') %>)
AM_MODE=(<%= arr.call('mode') %>)
AM_USER=(<%= arr.call('user') %>)
AM_KEY=(<%= arr.call('key') %>)
# base64: alertmanager.yaml content
AM_CONFIG=(<%= active.map { |c| b64.call(c['config']) }.join(' ') %>)
# base64: template file names (one per line); index matches AM_TEMPLATES_<n>
AM_TEMPLATE_NAMES=(<%= active.map { |c| b64.call(c['templates'].map(&:first).join("\n")) }.join(' ') %>)
<% active.each_with_index do |c, i| -%>
# base64: template contents of '<%= c['id'] %>' (same order as the names)
AM_TEMPLATES_<%= i %>=(<%= c['templates'].map { |_, content| b64.call(content) }.join(' ') %>)
<% end -%>
